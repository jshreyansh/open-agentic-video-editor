# ===========================================
# Frontend Configuration (Vite)
# ===========================================

# Show/hide floating debug button in editor (dev mode only)
# Set to 'false' to hide debug panel button during development
VITE_SHOW_DEBUG_PANEL=true

# Google Cloud project for Vertex AI Gemini (AI chat backend)
# Uses Application Default Credentials (ADC) — run: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT=my-project-123456
# GOOGLE_CLOUD_LOCATION=us-central1
